# YouTube Data API v3 keys
# Get yours at https://console.cloud.google.com/apis/credentials
#
# Option 1: Single key
YOUTUBE_API_KEY=your_api_key_here
#
# Option 2: Multiple keys (comma-separated) for quota rotation.
# When one key runs out of quota, the next one is used automatically.
# YOUTUBE_API_KEYS=AIzaSy_key1,AIzaSy_key2,AIzaSy_key3

# Directory where hourly reports and graphs are saved
REPORTS_DIR=./reports

# How often to poll viewer counts (seconds). Default: 60
POLL_INTERVAL=60

# How often to search for NEW live streams (seconds). Default: 600 (10 min)
# Only channels WITHOUT a known active stream are searched, so this
# mainly affects how quickly new programs are detected after one ends.
# search.list costs 100 quota units per channel, so keep this reasonable.
LIVE_SEARCH_INTERVAL=600
