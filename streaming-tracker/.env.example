# YouTube Data API v3 key
# Get yours at https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_api_key_here

# Directory where hourly reports and graphs are saved
REPORTS_DIR=./reports

# How often to poll viewer counts (in seconds). Default: 60
POLL_INTERVAL=60

# How often to search for new live streams (in seconds). Default: 300
# search.list costs 100 quota units, so we do it less frequently
LIVE_SEARCH_INTERVAL=300
